{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanSplit",
  "version": "0.1.1",
  "identifier": "com.scansplit.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ScanSplit", "width": 1100, "height": 760, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Andrew Park",
    "copyright": "© 2026 Andrew Park. All rights reserved.",
    "category": "Finance",
    "homepage": "https://7174andy.github.io/scansplit/",
    "shortDescription": "Split receipts fairly. Locally.",
    "longDescription": "ScanSplit turns receipt photos into a fair per-person cost split. Line items are read by the Anthropic API; everything else stays on your machine. No accounts, no server."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NEQ4MDgyMDM2QTY4MzIKUldReWFHb0Rnb0JOeElGbi9NbS8xeVRPQk90eDVhRkt6NFUzRmR6TDRoSndnSXZSVHJtYVdiY24K",
      "endpoints": [
        "https://github.com/7174Andy/scansplit/releases/latest/download/latest.json"
      ]
    }
  }
}
